{
  "name": "glow-studio-by-sofia",
  "version": "1.0.0",
  "private": true,
  "description": "Glow Studio by Sofia — Premium Beauty Salon Web Application",
  "scripts": {
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:bot\"",
    "build:all": "npm run build:web && npm run build:api",
    "test:all": "npm run test:web && npm run test:api && npm run test:bot",
    "type-check:all": "npm run type-check:web && npm run type-check:api",
    "validate:all": "npm run type-check:all && npm run test:all && npm run build:all",
    "build": "npm run build:all",
    "start": "cd apps/web && npm run start",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && npm run dev",
    "dev:bot": "cd apps/bot && python main.py",
    "build:web": "cd apps/web && npm run build",
    "build:api": "cd apps/api && npm run build",
    "type-check": "npm run type-check:all",
    "type-check:web": "cd apps/web && npm run type-check",
    "type-check:api": "cd apps/api && npm run type-check",
    "test": "npm run test:all",
    "test:web": "cd apps/web && npm run test",
    "test:api": "cd apps/api && npm run test",
    "test:bot": "python -m pytest apps/bot/tests",
    "install:web": "cd apps/web && npm install",
    "install:api": "cd apps/api && npm install",
    "install:bot": "cd apps/bot && pip install -r requirements.txt",
    "install:all": "npm run install:web && npm run install:api",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "npx prisma studio",
    "db:migrate": "npx prisma migrate dev",
    "db:reset": "npx prisma migrate reset",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "prisma": "^6.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
