// ============================================
// Glow Studio by Sofia — Prisma Schema
// ============================================

generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- ENUMS ----

enum Role {
  ADMIN
  STAFF
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum RecurrenceInterval {
  NONE
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum WaitlistStatus {
  WAITING
  OFFERED
  BOOKED
  EXPIRED
  CANCELLED
}

enum Platform {
  INSTAGRAM
  WHATSAPP
  WEB
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// ---- MODELS ----

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      Role     @default(ADMIN)
  image     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Service {
  id           String        @id @default(cuid())
  name         String
  description  String?
  price        Int           // Price in ARS (integer, e.g. 25000)
  duration     Int           // Duration in minutes
  category     String        // cabello, unas, facial, tratamientos
  imageUrl     String?       @map("image_url")
  active       Boolean       @default(true)
  order        Int           @default(0)
  appointments Appointment[]
  waitlists    Waitlist[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("services")
}

model Customer {
  id                     String        @id @default(cuid())
  name                   String
  phone                  String?
  email                  String?
  instagram              String?
  notes                  String?
  preferences            Json?         // Semantic memory: preferred styles, hair formulas, preferred times
  blocked                Boolean       @default(false)
  blockedReason          String?       @map("blocked_reason")
  lateCancellationsCount Int           @default(0) @map("late_cancellations_count")
  appointments           Appointment[]
  waitlists              Waitlist[]
  messages               MessageLog[]
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@map("customers")
}

model Staff {
  id           String        @id @default(cuid())
  name         String
  email        String?       @unique
  phone        String?
  avatarUrl    String?       @map("avatar_url")
  bio          String?
  specialties  String[]      @default([])
  active       Boolean       @default(true)
  calendarId   String?       @map("calendar_id")
  workingHours Json?         @map("working_hours")
  appointments Appointment[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("staff")
}

model Appointment {
  id              String             @id @default(cuid())
  token           String?            @unique @default(cuid())
  date            DateTime
  endDate         DateTime           @map("end_date")
  status          AppointmentStatus  @default(PENDING)
  notes           String?
  recurrence      RecurrenceInterval @default(NONE)
  lateCancellation Boolean           @default(false) @map("late_cancellation")
  reminderSent24h Boolean            @default(false) @map("reminder_sent_24h")
  reminderSent1h  Boolean            @default(false) @map("reminder_sent_1h")
  customerId      String             @map("customer_id")
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId       String             @map("service_id")
  service         Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId         String?            @map("staff_id")
  staff           Staff?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  calendarEventId String?            @unique @map("calendar_event_id")
  source          Platform           @default(WEB)
  review          Review?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([token])
  @@index([date])
  @@index([customerId])
  @@index([serviceId])
  @@index([staffId])
  @@index([status])
  @@map("appointments")
}

model Waitlist {
  id            String         @id @default(cuid())
  customerId    String         @map("customer_id")
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId     String         @map("service_id")
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  preferredDate DateTime       @map("preferred_date")
  timeRange     String?        @map("time_range") // e.g. "mañana", "tarde", "14:00-18:00"
  status        WaitlistStatus @default(WAITING)
  offeredAt     DateTime?      @map("offered_at")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([customerId])
  @@index([serviceId])
  @@index([preferredDate])
  @@index([status])
  @@map("waitlist")
}

model BlockedTime {
  id        String   @id @default(cuid())
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String   // e.g. "Vacaciones", "Feriado", "Almuerzo"
  allDay    Boolean  @default(false) @map("all_day")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startDate])
  @@index([endDate])
  @@map("blocked_times")
}

model Review {
  id            String       @id @default(cuid())
  rating        Int          // 1 to 5 stars
  comment       String?
  authorName    String       @map("author_name")
  serviceName   String?      @map("service_name")
  verified      Boolean      @default(true)
  appointmentId String?      @unique @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

model MessageLog {
  id         String           @id @default(cuid())
  platform   Platform
  senderId   String           @map("sender_id")
  senderName String?          @map("sender_name")
  message    String
  response   String?
  direction  MessageDirection
  customerId String?          @map("customer_id")
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([senderId])
  @@index([customerId])
  @@index([platform])
  @@index([createdAt])
  @@map("message_logs")
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  category  String?  // salon, unas, facial, cabello, ambiente
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("gallery_images")
}

model ConversationState {
  senderId  String   @id @map("sender_id")
  state     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("conversation_states")
}

model BaileysSession {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("baileys_sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}


