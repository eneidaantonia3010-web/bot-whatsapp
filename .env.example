# ============================================
# Glow Studio by Sofia — Variables de Entorno
# ============================================
# Copia este archivo como .env y rellena los valores reales.

# --- BASE DE DATOS (NEON POSTGRESQL) ---
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require"

# --- SEGURIDAD & AUTENTICACIÓN ---
JWT_SECRET="genera_una_cadena_secreta_y_larga_de_minimo_32_caracteres"
API_SECRET_KEY="clave_secreta_compartida_entre_api_y_bot_python"

# --- META DEVELOPER: WHATSAPP (Notificaciones & Webhooks) ---
WHATSAPP_PHONE_ID="tu_phone_id_de_meta"
WHATSAPP_TOKEN="tu_token_permanente_de_meta"
WEBHOOK_VERIFY_TOKEN="token_de_verificacion_webhook_meta"
META_APP_SECRET="app_secret_de_meta_para_validar_firma_sha256"
SALON_WHATSAPP="5491178296781"

# --- META DEVELOPER: INSTAGRAM (Chatbot de atención) ---
META_PAGE_ACCESS_TOKEN="tu_page_access_token_de_meta"
META_VERIFY_TOKEN="mismo_valor_que_WEBHOOK_VERIFY_TOKEN"

# --- GOOGLE CALENDAR (Sincronización) ---
GOOGLE_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
GOOGLE_CALENDAR_ID="tu_email@gmail.com"

# --- GROQ AI (Motor LLM & Visión) ---
GROQ_API_KEY="gsk_tu_api_key_de_groq"
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_FALLBACK_MODEL="llama-3.1-8b-instant"
GROQ_VISION_MODEL="llama-3.2-11b-vision-preview"

# --- TTS & VOZ (Opcional) ---
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
OPENAI_API_KEY=""

# --- SERVIDORES (Producción - Render) ---
BOT_URL="https://glow-studio-bot-alrb.onrender.com"
API_URL="https://glow-studio-api-2vzt.onrender.com"
FRONTEND_URL="https://glow-studio-web.onrender.com"
